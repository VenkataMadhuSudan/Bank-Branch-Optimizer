# Bank AI Optimizer - Environment Variables
# Copy this file to .env and configure your variables

# Neon PostgreSQL Database Connection
# Example: postgresql+psycopg2://<user>:<password>@<ep-hostname>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=
DATABASE_URL_POOLED=

# Application Environment (development, testing, production)
APP_ENV=development

# JWT Secret & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging
LOG_LEVEL=INFO

# Default Admin Setup (used on initial seed if configured)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@apexbank.local

